# Copy to .env only if you need to change defaults.
# NEVER put a real API key in this file and never commit .env

# mock = fully offline (default). No key, no network, no model download.
GA7_PROVIDER=mock

# Only used when GA7_PROVIDER=ollama (a local Ollama you installed yourself).
GA7_OLLAMA_BASE_URL=http://127.0.0.1:11434
GA7_OLLAMA_MODEL=

GA7_MAX_STEPS=6
GA7_WORKSPACE=data
GA7_LOG_DIR=logs
